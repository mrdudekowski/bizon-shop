+        <CatalogImage
+          src={model.imageUrl}
+          fallbackKey={model.slug}
+          alt={`${model.name} тАФ ╨│╤А╤Г╨╖╨╛╨▓╨░╤П ╤И╨╕╨╜╨░`}
+          fill
