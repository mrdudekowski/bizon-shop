+        <div>
+          <p>╨Ъ╨╛╨╜╤Д╨╕╨│╤Г╤А╨░╤Ж╨╕╤П ╨┤╨╗╤П ╤А╨░╤Б╤З╤С╤В╨░</p>
+          <h3>{model.name}</h3>
+        </div>
+        <span>╨ж╨╡╨╜╨░ ╨╕ ╤Б╨╛╨▓╨╝╨╡╤Б╤В╨╕╨╝╨╛╤Б╤В╤М ╨┐╨╛╨┤╤В╨▓╨╡╤А╨╢╨┤╨░╤О╤В╤Б╤П ╤Б╨┐╨╡╤Ж╨╕╨░╨╗╨╕╤Б╤В╨╛╨╝</span>
+      </div>
+
+      <div className={styles.grid}>
+        <label>
+          <span>╨Р╨▓╤В╨╛╨╝╨╛╨▒╨╕╨╗╤М *</span>
+          <input
+            name="vehicle"
+            required
+            maxLength={120}
+            placeholder="╨Ь╨░╤А╨║╨░ ╨╕ ╨╝╨╛╨┤╨╡╨╗╤М"
+            autoComplete="off"
+          />
+        </label>
+        <label>
+          <span>╨У╨╛╨┤ ╨▓╤Л╨┐╤Г╤Б╨║╨░ *</span>
+          <input
+            name="year"
+            type="number"
+            required
+            min={1950}
+            max={maxYear}
+            inputMode="numeric"
+            placeholder="2024"
+          />
+        </label>
+        <label>
+          <span>╨в╨╡╨║╤Г╤Й╨╕╨╣ ╤А╨░╨╖╨╝╨╡╤А ╨║╨╛╨╗╤С╤Б</span>
+          <input name="currentSize" maxLength={50} placeholder="╨Э╨░╨┐╤А╨╕╨╝╨╡╤А, 265/65 R17" />
+        </label>
+        <label>
+          <span>╨Ц╨╡╨╗╨░╨╡╨╝╤Л╨╣ ╤А╨░╨╖╨╝╨╡╤А</span>
+          <input name="desiredSize" maxLength={50} placeholder="╨Х╤Б╨╗╨╕ ╤Г╨╢╨╡ ╨╛╨┐╤А╨╡╨┤╨╡╨╗╨╕╨╗╨╕╤Б╤М" />
+        </label>
+        <label>
+          <span>╨Ш╤Б╨┐╨╛╨╗╨╜╨╡╨╜╨╕╨╡</span>
+          <input name="finish" maxLength={80} defaultValue={model.finish} />
