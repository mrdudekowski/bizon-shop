+      code: "CATEGORY_DESCRIPTION_MISSING",
+      item: category.slug,
+      message: "╨Т CMS ╨╜╨╡ ╨╖╨░╨┐╨╛╨╗╨╜╨╡╨╜╨╛ ╨╛╨┐╨╕╤Б╨░╨╜╨╕╨╡ ╨║╨░╤В╨╡╨│╨╛╤А╨╕╨╕.",
+    });
+  }
+  if (!hasUpload(category.coverImage)) {
+    findings.push({
+      severity: "warning",
+      code: "CATEGORY_COVER_MISSING",
+      item: category.slug,
+      message: "╨Т CMS ╨╜╨╡╤В ╨╛╨▒╨╗╨╛╨╢╨║╨╕; ╨┐╤Г╨▒╨╗╨╕╤З╨╜╨░╤П ╤Б╤В╤А╨░╨╜╨╕╤Ж╨░ ╨┐╨╛╨║╨░ ╨╕╤Б╨┐╨╛╨╗╤М╨╖╤Г╨╡╤В ╤Г╤В╨▓╨╡╤А╨╢╨┤╤С╨╜╨╜╤Л╨╣ ╤Б╤В╨░╤В╨╕╤З╨╡╤Б╨║╨╕╨╣ ╨░╤А╤В.",
+    });
+  }
+}
+
