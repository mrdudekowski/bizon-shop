+              onClick={() => setAutoplay((current) => !current)}
+              aria-label={autoplay ? "╨Я╤А╨╕╨╛╤Б╤В╨░╨╜╨╛╨▓╨╕╤В╤М ╨║╨░╤А╤Г╤Б╨╡╨╗╤М" : "╨Ч╨░╨┐╤Г╤Б╤В╨╕╤В╤М ╨║╨░╤А╤Г╤Б╨╡╨╗╤М"}
+            >
+              {autoplay ? "╨Я╨░╤Г╨╖╨░" : "╨б╤В╨░╤А╤В"}
+            </button>
+            <button
+              type="button"
+              onClick={() => selectSlide(activeIndex - 1)}
+              aria-label="╨Я╤А╨╡╨┤╤Л╨┤╤Г╤Й╨╡╨╡ ╨┐╤А╨╡╨╕╨╝╤Г╤Й╨╡╤Б╤В╨▓╨╛"
+            >
+              тЖР
+            </button>
+            <button
+              type="button"
+              onClick={() => selectSlide(activeIndex + 1)}
+              aria-label="╨б╨╗╨╡╨┤╤Г╤О╤Й╨╡╨╡ ╨┐╤А╨╡╨╕╨╝╤Г╤Й╨╡╤Б╤В╨▓╨╛"
+            >
+              тЖТ
+            </button>
+          </div>
+        </div>
+      ) : null}
+    </section>
+  );
+}
