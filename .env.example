# Public (client-safe)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_EMAIL=

# Published content API used by production static builds (backend-app).
CONTENT_API_URL=http://127.0.0.1:4000

# Yandex Metrika (optional)
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Public media URL only. Upload and storage credentials belong to backend-app.
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true
