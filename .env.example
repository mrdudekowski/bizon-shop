# Copy to .env before `npm run dev`. The dev script loads this file explicitly,
# so the server never depends on variables that happen to be set in the shell.
DATABASE_URI=postgres://user:password@127.0.0.1:5433/bizon

# Public browser origins allowed to call the API with cookies.
# Use exact origins, comma-separated; do not add trailing slashes.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# Configure only after confirming how the App Platform ingress appends X-Forwarded-For.
# When unset, rate limiting uses the network peer address and ignores forwarded headers.
TRUSTED_PROXY_HOPS=0
API_RATE_LIMIT_MAX=30
API_RATE_LIMIT_WINDOW_MS=60000

# CMS accounts, created once on the first start. An account that already has a
# password keeps it, so changing these values cannot take over an existing login.
# Always wrap a password in double quotes: outside quotes a `#` starts a comment
# and everything after it is silently dropped.
CMS_BOOTSTRAP_ADMIN_LOGIN=
CMS_BOOTSTRAP_ADMIN_PASSWORD=
CMS_BOOTSTRAP_EDITOR_LOGIN=
CMS_BOOTSTRAP_EDITOR_PASSWORD=

# S3-compatible object storage (upload). Values stay in local .env, not git.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# Trigger a new build only after published or hidden public content changes.
# The account API token and public-site application ID stay in backend variables.
TIMEWEB_CLOUD_TOKEN=
TIMEWEB_PUBLIC_SITE_APP_ID=
