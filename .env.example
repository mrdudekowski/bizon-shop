# Public backend origin used by the browser; it contains no credentials.
NEXT_PUBLIC_ADMIN_API_URL=http://127.0.0.1:4000
# Public site origin for "open on site" links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# `npm run dev` copies this published snapshot into public/content-snapshot.json.
# The browser then reads it from the CMS origin when the admin API cannot answer.
# CONTENT_SNAPSHOT_SOURCE=https://example.com/content-snapshot.json
# NEXT_PUBLIC_CONTENT_SNAPSHOT_URL=/content-snapshot.json
