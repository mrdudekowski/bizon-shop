{
  "name": "bizon_main_app",
  "version": "2.0.0",
  "description": "BIZON public site — Next.js 15 (main-app branch)",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3001",
    "dev:clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\" && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=--no-deprecation node scripts/buildWithContentRevision.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium firefox webkit",
    "lint": "eslint src next.config.mjs",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrdudekowski/bizon.git"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "cross-env": "^10.1.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.562.0",
    "next": "15.5.27",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.17",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.27",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "5.8.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
